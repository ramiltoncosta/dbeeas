# Configuração de PRODUÇÃO. Copie para ".env" e preencha.
# O arquivo .env NÃO vai para o GitHub (contém senhas).

# Domínios
SITE_DOMAIN=dbeeas.com.br
API_DOMAIN=api.dbeeas.com.br

# E-mail para os avisos do certificado HTTPS (Let's Encrypt)
ACME_EMAIL=seu-email@exemplo.com

# Senha do banco de dados (gere com: openssl rand -hex 24)
POSTGRES_PASSWORD=

# Segredo dos tokens de login (gere com: openssl rand -hex 32)
JWT_SECRET=

# E-mail (deixe SMTP_HOST vazio enquanto não tiver o serviço;
# os e-mails aparecem no log do backend)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=DBeeAS <nao-responda@dbeeas.com.br>
# Recebe as mensagens do formulário de contato do site
EMAIL_CONTATO=contato@dbeeas.com.br

# true = pesquisadores precisam ser aprovados por um administrador
# para ver a localização exata de espécies sensíveis
PESQUISADOR_REQUER_APROVACAO=false

# Assinaturas: dias de teste para contas novas e serviço de cobrança ("manual" por enquanto)
DIAS_TESTE=30
GATEWAY_PAGAMENTO=manual
